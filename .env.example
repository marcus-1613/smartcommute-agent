# ============================================================
# SmartCommute AI 环境变量示例
# 复制本文件为 .env 并填写真实值。切勿提交 .env 到 Git。
# ============================================================

# ---- 应用 ----
APP_ENV=development                # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- 数据库 ----
# 本地开发默认 SQLite；生产可切换 PostgreSQL
DATABASE_URL=sqlite:///./smartcommute.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/smartcommute

# ---- 会话持久化（LangGraph Checkpointer）----
# SQLite Checkpointer 文件路径，用于保存工作流会话状态（按 thread_id 恢复多轮会话）。
# 默认自动启用，路径为项目根目录 smartcommute.checkpoint.sqlite，一般无需修改。
# SMARTCOMMUTE_CHECKPOINT_PATH=./smartcommute.checkpoint.sqlite

# ---- DeepSeek（OpenAI 兼容接口）----
# 可选。用于理解自然语言、组织工作流与生成推荐解释。
# 未配置时自动降级为规则解析（无 LLM 能力，通勤字段提取仍可用）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 地图 / 路线数据源 ----
# 首选 OneMap Routing API（新加坡官方，免费，无需绑信用卡）。
# 申请 Token：注册 https://www.onemap.gov.sg/ → 登录后进入
# 「API / Developer」页面，创建应用并获取 API Token（Authorization 用）。
# 配置后路线使用真实 OneMap 数据；未配置则回退到 Google Maps / Mock。
ONEMAP_TOKEN=
ONEMAP_ROUTING_ENDPOINT=https://www.onemap.gov.sg/api/public/routingsvc/route

# 次选 Google Maps Platform Routes API（需绑信用卡，未配置时自动回退）。
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ROUTES_ENDPOINT=https://routes.googleapis.com/directions/v2:computeRoutes

# 新加坡 LTA DataMall（可选，用于公交到站 / 交通事件增强）
# 配置后，交通事件（get_traffic_incidents）使用真实 LTA 数据；未配置走 Mock。
LTA_ACCOUNT_KEY=
LTA_DATAMALL_BASE_URL=https://datamall.lta.gov.sg

# ---- 天气数据源 ----
# 默认使用 Open-Meteo（免费、无需 Key）；设为 mock 可强制使用模拟天气。
WEATHER_PROVIDER=open_meteo

# ---- 前端 ----
# 前端开发服务器代理到后端
VITE_API_BASE_URL=http://localhost:8000

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
